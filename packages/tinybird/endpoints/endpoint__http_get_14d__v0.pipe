TAGS "http"

NODE endpoint
SQL >

    %
    SELECT * REPLACE(if(trigger IN ('cron', 'api'), trigger, 'cron') AS trigger)
    FROM mv__http_full_14d__v0
    WHERE
        monitorId = {{ String(monitorId, '1', required=True) }}
        AND id = {{ String(id, '', required=True) }}
    ORDER BY time DESC


TYPE ENDPOINT
